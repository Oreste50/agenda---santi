<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0c5f5b"><title>Agenda Santi</title>
<style>
:root{--teal:#0b625e;--cream:#fbf7ea;--paper:#fffdf7;--ink:#163c3a;--muted:#6c746e;--blue:#2689d8;--red:#e53b3b;--yellow:#f1ad18;--green:#4fae4d;--brown:#9a6a3a;--purple:#8d4bd4;--shadow:0 5px 20px #153b3a16}*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;background:linear-gradient(145deg,#f4f7ef,#fff7e8);color:var(--ink)}button,input,textarea{font:inherit}button{border:0;background:none;color:inherit}.app{max-width:520px;margin:auto;min-height:100vh;background:var(--cream);position:relative;overflow:hidden}.screen{padding:14px 14px 88px;min-height:100vh;background:radial-gradient(circle at 10% 0%,#fff 0 16%,transparent 40%)}.hero{border-radius:22px;padding:18px;background:linear-gradient(150deg,#dfece8,#f9ead1);box-shadow:var(--shadow);position:relative;overflow:hidden}.hero:after{content:'🍂';position:absolute;right:10px;top:-12px;font-size:72px;opacity:.18}.brand{font-family:Georgia,serif;font-size:24px;font-weight:700;letter-spacing:.5px}.sub{font-family:Georgia,serif;font-style:italic;margin-top:2px;color:#315a57}.logo{position:absolute;right:12px;top:10px;width:125px;height:62px;display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:10px;background:#07111f}.date{margin-top:28px}.dow{font-size:19px;font-weight:650}.bigday{font-family:Georgia,serif;font-size:76px;line-height:.9}.date small{font-size:14px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:10px}.card{background:#fffdf8dd;border:1px solid #ffffffaa;border-radius:16px;padding:12px;box-shadow:var(--shadow)}.weather{font-size:25px;font-weight:700}.muted{color:var(--muted);font-size:12px}.info-title{font-size:13px}.info-main{font-family:Georgia,serif;font-size:18px;font-weight:700}.assistant{margin-top:10px}.assistant-head{display:flex;gap:12px;align-items:center}.avatar{width:54px;height:54px;border-radius:50%;background:#d9efff;border:2px solid #2089d8;display:grid;place-items:center;font-size:28px}.assistant-title{font-family:Georgia,serif;font-size:22px;font-weight:700}.inputrow{display:grid;grid-template-columns:minmax(0,1fr) 42px;grid-template-rows:auto 42px;gap:7px;margin-top:10px;align-items:center}.inputrow input{flex:1;border:1px solid #d6ddd7;border-radius:22px;padding:11px 14px;background:white}.round{width:42px;height:42px;border-radius:50%;background:var(--teal);color:white;display:grid;place-items:center;cursor:pointer}.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:9px}.chip{padding:7px 10px;border-radius:16px;background:#fff;border:1px solid #dce4de;font-size:12px;cursor:pointer}.section-title{display:flex;justify-content:space-between;align-items:center;margin:14px 2px 8px;font-family:Georgia,serif;font-size:21px}.toolbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}.toolbar h1{font-family:Georgia,serif;font-size:25px;margin:0}.navbtn{width:36px;height:36px;border-radius:50%;background:#fff;box-shadow:var(--shadow);cursor:pointer}.today{background:var(--teal);color:#fff;border-radius:16px;padding:7px 11px;cursor:pointer}.weekhead,.calgrid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}.weekhead div{text-align:center;font-size:11px;font-weight:700;color:#606c67}.day{min-height:48px;background:#fff;border-radius:10px;padding:5px;text-align:center;position:relative;cursor:pointer}.day.mutedday{opacity:.35}.day.sel{background:var(--teal);color:#fff}.day.sun{color:#d62e2e}.day.sel.sun{color:#fff}.dots{display:flex;justify-content:center;gap:2px;margin-top:4px}.dot{width:5px;height:5px;border-radius:50%;display:inline-block}.legend{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0;font-size:10px}.legend span{display:flex;align-items:center;gap:3px}.event{display:flex;gap:9px;align-items:center;background:#fff;border-radius:13px;padding:10px;margin:7px 0;box-shadow:var(--shadow);cursor:pointer}.stripe{width:4px;height:42px;border-radius:4px}.etime{width:44px;font-weight:700;font-size:12px}.ename{font-weight:650;font-size:13px}.ecat{font-size:10px;color:var(--muted)}.icon{margin-left:auto;font-size:20px}.fab{position:fixed;right:max(18px,calc((100vw - 520px)/2 + 18px));bottom:74px;width:54px;height:54px;border-radius:50%;background:var(--teal);color:#fff;font-size:28px;box-shadow:0 7px 22px #063d3a40;z-index:4}.bottom{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(520px,100vw);height:68px;background:#fffdf9f2;backdrop-filter:blur(10px);display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid #e3e4dd;z-index:5}.bottom button{font-size:10px;color:#66716d;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;cursor:pointer}.bottom button.active{color:var(--teal);font-weight:700}.bottom b{font-size:20px}.weeklist .event{margin:5px 0}.yeargrid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.monthtile{height:88px;border-radius:13px;padding:10px;background:linear-gradient(145deg,#e3edf2,#f5eadb);display:flex;align-items:flex-end;font-family:Georgia,serif;font-size:16px;font-weight:700;cursor:pointer;box-shadow:var(--shadow)}.monthtile.sel{outline:3px solid #e6a22d}.modal{position:fixed;inset:0;background:#0a333355;display:none;align-items:flex-end;z-index:10}.modal.show{display:flex}.sheet{background:var(--cream);width:min(520px,100%);margin:auto 0 0;border-radius:24px 24px 0 0;padding:18px 16px max(22px,env(safe-area-inset-bottom));max-height:90vh;overflow:auto}.sheet h2{font-family:Georgia,serif;margin:0 0 12px}.formrow{margin:9px 0}.formrow label{font-size:12px;color:var(--muted);display:block;margin-bottom:4px}.formrow input,.formrow select,.formrow textarea{width:100%;padding:11px;border:1px solid #d5ddd7;border-radius:11px;background:white}.twocol{display:grid;grid-template-columns:1fr 1fr;gap:8px}.actions{display:flex;gap:8px;margin-top:14px}.primary{flex:1;background:var(--teal);color:#fff;padding:12px;border-radius:12px}.secondary{padding:12px;border-radius:12px;background:#e8ece7}.photo-preview{width:100%;max-height:220px;object-fit:cover;border-radius:12px;margin-top:8px}.toggle{display:flex;align-items:center;justify-content:space-between;background:white;border-radius:12px;padding:10px;margin:5px 0}.toggle input{width:22px;height:22px}.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:82px;background:#183d3a;color:#fff;padding:10px 14px;border-radius:20px;display:none;z-index:20;font-size:13px}.empty{text-align:center;padding:35px 10px;color:var(--muted)}@media(min-width:700px){body{padding:20px}.app{border-radius:28px;box-shadow:0 15px 50px #123b3a20}}
.alert-options{margin:8px 0 10px;padding:10px;border:1px solid #e7dfcf;border-radius:14px;background:#fffaf0}.alert-options .formrow{margin-bottom:8px}.alert-options .formrow:last-of-type{margin-bottom:4px}.alert-options select{width:100%}.color-picker{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:6px}.color-choice{display:flex;align-items:center;gap:7px;padding:8px 7px;border:1px solid rgba(255,255,255,.14);border-radius:10px;background:#111b29;color:#eef3f8;cursor:pointer;font-size:12px}.color-choice.selected{border-color:#fff;box-shadow:0 0 0 2px rgba(255,255,255,.16)}.color-choice .dot{width:16px;height:16px;border-radius:50%;flex:0 0 16px}.inputrow .voicebtn{grid-column:2;grid-row:1}.inputrow .sendbtn{grid-column:2;grid-row:2}.inputrow input{grid-column:1;grid-row:1;min-width:0;width:100%}</style></head>
<body><main class="app" id="app"></main><div class="modal" id="modal"><div class="sheet" id="sheet"></div></div><div class="toast" id="toast"></div>
<script>
const C={medica:'#2689d8',importante:'#e53b3b',recurrente:'#f1ad18',personal:'#4fae4d',pagos:'#9a6a3a',ocio:'#8d4bd4',salud:'#4fae4d',trabajo:'#2689d8'};
const names=['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
let state={view:'home',date:new Date(2026,8,24),events:JSON.parse(localStorage.getItem('agendaSantiEvents')||'null')||[
{id:1,title:'Desayuno y revisión del día',date:'2026-09-24',time:'09:00',end:'09:30',cat:'personal',icon:'☕',repeat:'none',alert:false},
{id:2,title:'Gimnasio',date:'2026-09-24',time:'10:00',end:'11:00',cat:'recurrente',icon:'🏋️',repeat:'weekly',alert:false},
{id:3,title:'Paseo',date:'2026-09-24',time:'13:00',end:'13:40',cat:'salud',icon:'🚶',repeat:'daily',alert:false},
{id:4,title:'Revisión trading',date:'2026-09-24',time:'16:30',end:'17:15',cat:'trabajo',icon:'📈',repeat:'none',alert:false},
{id:5,title:'Recordatorio importante',date:'2026-09-24',time:'18:30',end:'18:45',cat:'importante',icon:'🔔',repeat:'none',alert:true},
{id:6,title:'Tiempo libre',date:'2026-09-24',time:'20:00',end:'21:00',cat:'personal',icon:'📖',repeat:'none',alert:false},
{id:7,title:'Pinturas con Eloy',date:'2026-09-25',time:'10:00',end:'11:00',cat:'personal',icon:'🎨',repeat:'none',alert:false}
]};
function save(){localStorage.setItem('agendaSantiEvents',JSON.stringify(state.events))} function pad(n){return String(n).padStart(2,'0')} function iso(d){return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())} function fmt(d){return d.toLocaleDateString('es-ES',{weekday:'long',day:'numeric',month:'long',year:'numeric'})} function esc(s){return String(s??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}
function color(cat){return C[cat]||C.personal} function label(cat){return ({medica:'Médica',importante:'Importante',recurrente:'Recurrente',personal:'Personal',pagos:'Pagos',ocio:'Ocio',salud:'Salud',trabajo:'Trabajo personal'})[cat]||cat}
function evFor(date){let s=iso(date);return state.events.filter(e=>e.date===s).sort((a,b)=>a.time.localeCompare(b.time))}
function nav(){return `<nav class="bottom">${[['home','⌂','Inicio'],['month','▦','Calendario'],['week','▤','Semana'],['year','▧','Año'],['settings','⚙','Ajustes']].map(x=>`<button class="${state.view===x[0]?'active':''}" onclick="setView('${x[0]}')"><b>${x[1]}</b>${x[2]}</button>`).join('')}</nav>`}
function home(){let d=state.date, es=evFor(d);return `<section class="screen"><div class="hero"><div class="brand">AGENDA SANTI</div><div class="sub">Tu día, más sencillo</div><div class="logo" aria-label="SanCapital"><img src="data:image/png;base64," alt="SanCapital" style="width:100%;height:100%;object-fit:cover;object-position:center;border-radius:10px"></div><div class="date"><div class="dow">${d.toLocaleDateString('es-ES',{weekday:'long'})}</div><div class="bigday">${d.getDate()}</div><small>de ${names[d.getMonth()]} de ${d.getFullYear()}</small></div><div class="grid2"><div class="card"><div class="weather">☀️ 24 °C</div><div class="muted">Máx. 27° · Mín. 21°<br>Las Palmas de G.C.</div></div><div class="card"><div class="weather">♎ Libra</div><div class="muted">Equilibrio, armonía<br>y relaciones</div></div></div><div class="grid2"><div class="card"><div class="info-title">Santo del día</div><div class="info-main">Ntra. Sra. de la Merced</div></div><div class="card"><div class="info-title">Estación</div><div class="info-main">Otoño 🍂</div></div></div><div class="card assistant"><div class="assistant-head"><div class="avatar">👩🏻</div><div><div class="assistant-title">Hablar con Clara</div><div class="muted">Tu asistente personal de agenda</div></div></div><div class="inputrow"><input id="claraInput" placeholder="Escribe o habla con Clara..."><button class="round voicebtn" onclick="voice()">🎙</button><button class="round sendbtn" onclick="clara()">➤</button></div><div class="chips"><button class="chip" onclick="ask('¿Qué tengo hoy?')">¿Qué tengo hoy?</button><button class="chip" onclick="ask('Llévame al mes')">Llévame al mes</button><button class="chip" onclick="ask('Tareas importantes')">Tareas importantes</button><button class="chip" onclick="ask('Añade una cita')">Añade una cita</button></div></div></div><div class="section-title"><span>Hoy</span><span class="muted">${es.length} gestiones</span></div>${es.length?es.map(eventHTML).join(''):'<div class="empty">No hay gestiones para hoy.</div>'}</section>${nav()}<button class="fab" onclick="openEvent()">+</button>`}
function legend(){return `<div class="legend">${Object.entries({medica:'Médica',importante:'Importante',recurrente:'Recurrente',personal:'Personal',pagos:'Pagos',ocio:'Ocio'}).map(([k,v])=>`<span><i class="dot" style="background:${color(k)}"></i>${v}</span>`).join('')}</div>`}
function month(){let d=state.date,y=d.getFullYear(),m=d.getMonth(),first=new Date(y,m,1),start=(first.getDay()+6)%7,days=new Date(y,m+1,0).getDate(),cells=[];for(let i=0;i<start;i++){let pd=new Date(y,m,1);pd.setDate(i-start+1);cells.push({d:pd,muted:true})}for(let n=1;n<=days;n++)cells.push({d:new Date(y,m,n),muted:false});while(cells.length<42){let ld=cells[cells.length-1].d;let nd=new Date(ld);nd.setDate(ld.getDate()+1);cells.push({d:nd,muted:true})}return `<section class="screen"><div class="toolbar"><button class="navbtn" onclick="moveMonth(-1)">‹</button><h1>${names[m]} ${y}</h1><div><button class="navbtn" onclick="moveMonth(1)">›</button></div></div><div class="card"><div class="weekhead">${['L','M','X','J','V','S','D'].map(x=>`<div>${x}</div>`).join('')}</div><div class="calgrid">${cells.map(x=>{let es=evFor(x.d);return `<div class="day ${x.muted?'mutedday':''} ${iso(x.d)===iso(state.date)?'sel':''} ${x.d.getDay()===0?'sun':''}" onclick="selectDate('${iso(x.d)}')">${x.d.getDate()}${es.length?`<div class="dots">${es.slice(0,4).map(e=>`<i class="dot" style="background:${color(e.cat)}"></i>`).join('')}</div>`:''}</div>`}).join('')}</div>${legend()}</div><div class="section-title">Eventos del día <span class="muted">${fmt(state.date)}</span></div>${evFor(state.date).map(eventHTML).join('')||'<div class="empty">Sin eventos.</div>'}</section>${nav()}<button class="fab" onclick="openEvent()">+</button>`}
function week(){let d=new Date(state.date),day=(d.getDay()+6)%7,start=new Date(d);start.setDate(d.getDate()-day);let days=Array.from({length:7},(_,i)=>{let x=new Date(start);x.setDate(start.getDate()+i);return x});return `<section class="screen"><div class="toolbar"><button class="navbtn" onclick="moveWeek(-1)">‹</button><h1>Semana</h1><button class="navbtn" onclick="moveWeek(1)">›</button></div><div class="card"><div style="text-align:center;font-weight:700;margin-bottom:8px">${days[0].getDate()} – ${days[6].getDate()} ${names[days[6].getMonth()]} ${days[6].getFullYear()}</div><div class="weeklist">${days.map(x=>`<div class="section-title" style="font-size:16px;margin-top:10px"><span>${x.toLocaleDateString('es-ES',{weekday:'short'})} ${x.getDate()}</span><span class="muted">${evFor(x).length}</span></div>${evFor(x).map(eventHTML).join('')||'<div class="muted" style="padding:4px 0">Sin gestiones</div>'}`).join('')}</div>${legend()}</div></section>${nav()}<button class="fab" onclick="openEvent()">+</button>`}
function day(){return `<section class="screen"><div class="toolbar"><button class="navbtn" onclick="moveDay(-1)">‹</button><h1>${state.date.toLocaleDateString('es-ES',{weekday:'short',day:'numeric',month:'short'})}</h1><button class="navbtn" onclick="moveDay(1)">›</button></div><div class="grid2"><div class="card">☀️ <b>24 °C</b><div class="muted">Las Palmas de G.C.</div></div><div class="card">♎ <b>Libra</b><div class="muted">Equilibrio · Armonía</div></div></div>${evFor(state.date).map(eventHTML).join('')||'<div class="empty">Día libre.</div>'}</section>${nav()}<button class="fab" onclick="openEvent()">+</button>`}
function year(){return `<section class="screen"><div class="toolbar"><button class="navbtn" onclick="state.date.setFullYear(state.date.getFullYear()-1);render()">‹</button><h1>Año ${state.date.getFullYear()}</h1><button class="navbtn" onclick="state.date.setFullYear(state.date.getFullYear()+1);render()">›</button></div><div class="yeargrid">${names.map((n,i)=>`<div class="monthtile ${i===state.date.getMonth()?'sel':''}" onclick="state.date.setMonth(${i});setView('month')">${n}</div>`).join('')}</div><div class="card" style="margin-top:12px"><b>Información y herramientas</b><div class="grid2" style="margin-top:8px"><button class="chip" onclick="toast('Tiempo de Las Palmas')">☀️ Tiempo</button><button class="chip" onclick="toast('Horóscopo disponible')">♎ Horóscopo</button><button class="chip" onclick="toast('Santo del día')">⛪ Santo del día</button><button class="chip" onclick="toast('Noticias disponibles en la versión conectada')">📰 Noticias</button></div></div></section>${nav()}`}
function settings(){return `<section class="screen"><div class="toolbar"><h1>Ajustes</h1></div><div class="card">${[['🔔','Avisos y notificaciones','Gestiona los recordatorios'],['🎨','Categorías y colores','Personaliza la leyenda'],['📱','Instalación móvil','La versión PWA podrá instalarse como app'],['🔐','Seguridad y datos','Los datos de este prototipo quedan en este dispositivo']].map(x=>`<div class="event" onclick="toast('${x[1]}')"><span style="font-size:22px">${x[0]}</span><div><div class="ename">${x[1]}</div><div class="ecat">${x[2]}</div></div><span>›</span></div>`).join('')}</div></section>${nav()}`}
function eventHTML(e){return `<div class="event" onclick="openEvent(${e.id})"><div class="etime">${e.time}</div><div class="stripe" style="background:${color(e.cat)}"></div><div><div class="ename">${esc(e.title)}</div><div class="ecat"><i class="dot" style="background:${color(e.cat)}"></i> ${label(e.cat)} ${e.alert?' · 🔔':''}</div></div><div class="icon">${e.icon||''}</div></div>`}
function openEvent(id=null){let e=id?state.events.find(x=>x.id===id):null;if(!e)e={id:null,title:'',date:iso(state.date),time:'10:00',end:'11:00',cat:'personal',icon:'',repeat:'none',alert:false,alert1:'',alert2:'',photo:''};if(!['none','daily','weekly','monthly','yearly'].includes(e.repeat))e.repeat='none';window.editing=e;document.getElementById('sheet').innerHTML=`<h2>${id?'Editar evento':'Nuevo evento'}</h2><div class="formrow"><label>Título</label><input id="fTitle" value="${esc(e.title)}" placeholder="Escribe el título"></div><div class="twocol"><div class="formrow"><label>Fecha</label><input id="fDate" type="date" value="${e.date}"></div><div class="formrow"><label>Hora</label><input id="fTime" type="time" value="${e.time}"></div></div><div class="twocol"><div class="formrow"><label>Fin</label><input id="fEnd" type="time" value="${e.end||''}"></div><div class="formrow"><label>Categoría</label><select id="fCat">${Object.entries({medica:'Médica',importante:'Importante',recurrente:'Recurrente',personal:'Personal',pagos:'Pagos',ocio:'Ocio',salud:'Salud',trabajo:'Trabajo personal'}).map(([k,v])=>`<option value="${k}" ${e.cat===k?'selected':''}>${v}</option>`).join('')}</select></div></div><div class="formrow"><label>Color / importancia</label><div class="color-picker">${Object.entries({importante:["Importante",C.importante],recurrente:["Recurrente",C.recurrente],personal:["Personal",C.personal],medica:["Médica",C.medica],pagos:["Pagos",C.pagos],ocio:["Ocio",C.ocio]}).map(([k,v])=>`<button type="button" class="color-choice ${e.cat===k?"selected":""}" id="catColor-${k}" onclick="chooseCat('${k}')"><i class="dot" style="background:${v[1]}"></i>${v[0]}</button>`).join("")}</div></div><div class="formrow"><label>Descripción</label><textarea id="fDesc" rows="3">${esc(e.desc||'')}</textarea></div><div class="formrow"><label>Fotografía</label><input id="fPhoto" type="file" accept="image/*" onchange="previewPhoto(event)">${e.photo?`<img id="photoPreview" class="photo-preview" src="${e.photo}">`:''}</div><div class="toggle"><span>🔔 Avisos para esta gestión</span><input id="fAlert" type="checkbox" ${e.alert?'checked':''} onchange="toggleAlerts()"></div><div id="alertOptions" class="alert-options" style="${e.alert?'':'display:none'}"><div class="formrow"><label>Aviso 1</label><select id="fAlert1"><option value="">Sin aviso</option><option value="10m">10 minutos antes</option><option value="15m">15 minutos antes</option><option value="30m">30 minutos antes</option><option value="1h">1 hora antes</option><option value="2h">2 horas antes</option><option value="1d">1 día antes</option></select></div><div class="formrow"><label>Aviso 2</label><select id="fAlert2"><option value="">Sin aviso</option><option value="10m">10 minutos antes</option><option value="15m">15 minutos antes</option><option value="30m">30 minutos antes</option><option value="1h">1 hora antes</option><option value="2h">2 horas antes</option><option value="1d">1 día antes</option></select></div><div class="muted">Puedes elegir hasta dos avisos para una misma gestión.</div></div><div class="toggle"><span>🔁 Repetición</span><select id="fRepeat"><option value="none">No se repite</option><option value="daily">Diaria</option><option value="weekly">Semanal</option><option value="monthly">Mensual</option><option value="yearly">Anual</option></select></div><div class="actions">${id?`<button class="secondary" onclick="deleteEvent(${id})">Eliminar</button>`:''}<button class="primary" onclick="saveEvent()">Guardar</button><button class="secondary" onclick="closeModal()">Cancelar</button></div>`;document.getElementById('fRepeat').value=e.repeat||'none';if(document.getElementById('fAlert1'))document.getElementById('fAlert1').value=e.alert1||'';if(document.getElementById('fAlert2'))document.getElementById('fAlert2').value=e.alert2||'';document.getElementById('modal').classList.add('show')}
function chooseCat(cat){let s=document.getElementById('fCat');if(s)s.value=cat;document.querySelectorAll('.color-choice').forEach(b=>b.classList.remove('selected'));let b=document.getElementById('catColor-'+cat);if(b)b.classList.add('selected')}
function closeModal(){document.getElementById('modal').classList.remove('show')}
function previewPhoto(ev){let f=ev.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{let old=document.getElementById('photoPreview');if(!old){old=document.createElement('img');old.id='photoPreview';old.className='photo-preview';ev.target.after(old)}old.src=r.result;window.editing.photo=r.result};r.readAsDataURL(f)}
function toggleAlerts(){let on=document.getElementById('fAlert').checked;let box=document.getElementById('alertOptions');if(box)box.style.display=on?'block':'none';if(on){let a1=document.getElementById('fAlert1'),a2=document.getElementById('fAlert2');if(a1&&!a1.value)a1.value='1h';if(a2&&!a2.value)a2.value='1d'}}
const alertTimers={};
function alertMinutes(v){return ({'10m':10,'15m':15,'30m':30,'1h':60,'2h':120,'1d':1440}[v]||0)}
function scheduleEventAlerts(e){if(!e||!e.alert)return;['1','2'].forEach(n=>{let key=e.id+'-'+n;if(alertTimers[key]){clearTimeout(alertTimers[key]);delete alertTimers[key]}let value=e['alert'+n];let mins=alertMinutes(value);if(!mins)return;let when=new Date(e.date+'T'+e.time).getTime()-mins*60000;let delay=when-Date.now();if(delay<=0)return;alertTimers[key]=setTimeout(()=>{let title='Agenda Santi';let body=(n==='1'?'Aviso 1: ':'Aviso 2: ')+(e.title||'Gestión')+' — '+(value==='1d'?'en 1 día':value==='1h'?'en 1 hora':value.replace('m',' minutos')+' antes');if('Notification'in window&&Notification.permission==='granted')new Notification(title,{body});else toast(body);delete alertTimers[key]},delay)})}
function scheduleAllAlerts(){state.events.forEach(scheduleEventAlerts)}
function saveEvent(){let e=window.editing;e.title=document.getElementById('fTitle').value.trim()||'Sin título';e.date=document.getElementById('fDate').value;e.time=document.getElementById('fTime').value;e.end=document.getElementById('fEnd').value;e.cat=document.getElementById('fCat').value;e.desc=document.getElementById('fDesc').value;e.alert=document.getElementById('fAlert').checked;e.alert1=document.getElementById('fAlert1')?.value||'';e.alert2=document.getElementById('fAlert2')?.value||'';if(e.alert&&!e.alert1)e.alert1='1h';if(e.alert&&!e.alert2)e.alert2='1d';e.repeat=document.getElementById('fRepeat').value;if(!['none','daily','weekly','monthly','yearly'].includes(e.repeat))e.repeat='none';if(!e.id){e.id=Date.now();state.events.push(e)}else{let i=state.events.findIndex(x=>x.id===e.id);state.events[i]=e}save();scheduleEventAlerts(e);closeModal();state.date=new Date(e.date+'T12:00');render();if(e.alert)requestNotifications();toast(e.alert?'Gestión guardada con avisos: 1 hora y 1 día antes.':'Gestión guardada')}
function deleteEvent(id){state.events=state.events.filter(e=>e.id!==id);save();closeModal();render();toast('Gestión eliminada')}
function setView(v){state.view=v;render()}function selectDate(s){state.date=new Date(s+'T12:00');state.view='day';render()}function moveMonth(n){state.date.setMonth(state.date.getMonth()+n);render()}function moveWeek(n){state.date.setDate(state.date.getDate()+n*7);render()}function moveDay(n){state.date.setDate(state.date.getDate()+n);render()}
function speak(t){if(!('speechSynthesis' in window))return;window.speechSynthesis.cancel();let u=new SpeechSynthesisUtterance(t);u.lang='es-ES';u.rate=.96;u.pitch=1;window.speechSynthesis.speak(u)}
function ask(t){document.getElementById('claraInput').value=t;clara(true)}
function clara(speakIt=false){let raw=document.getElementById('claraInput').value.trim();let v=raw.toLowerCase().replace(/[¿?¡!.,;]/g,' ');if(!raw)return;if(v.includes('mes')){setView('month');if(speakIt)speak('Te llevo al calendario mensual.');return}if(v.includes('semana')){setView('week');if(speakIt)speak('Te muestro la semana.');return}if(v.includes('añade')||v.includes('añadir')||v.includes('cita')){openEvent();if(speakIt)speak('Claro. Vamos a añadir una gestión.');return}let day=new Date(state.date);if(v.includes('mañana'))day.setDate(day.getDate()+1);else if(v.includes('ayer'))day.setDate(day.getDate()-1);let events=evFor(day);let onlyImportant=v.includes('importante')||v.includes('importantes');if(onlyImportant)events=events.filter(e=>e.cat==='importante');let label=day.toLocaleDateString('es-ES',{day:'numeric',month:'long'});let msg;if(onlyImportant){let details=events.map(e=>{let name=(e.title||'Evento sin título').trim();let hour=e.time?` a las ${e.time}`:'';return `${name}${hour}`}).join('; ');msg=events.length?`Para ${label} tienes ${events.length} evento${events.length===1?'':'s'} importante${events.length===1?'':'s'}: ${details}.`:`No tienes eventos importantes para ${label}.`;}else{msg=events.length?`Para ${label} tienes ${events.length} gestión${events.length===1?'':'es'}: ${events.map(e=>e.title).join(', ')}.`:`No tienes gestiones para ${label}.`;}toast(msg);if(speakIt)speak(msg)}
function voice(){let SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){toast('Para hablar con Clara necesitamos abrir la agenda desde una conexión segura en el móvil.');return}let r=new SR();r.lang='es-ES';r.interimResults=false;r.maxAlternatives=1;r.onstart=()=>toast('Clara está escuchando…');r.onerror=e=>toast(e.error==='not-allowed'?'Permite el micrófono para hablar con Clara.':'No he podido escuchar. Inténtalo de nuevo.');r.onresult=e=>{let text=e.results[0][0].transcript;document.getElementById('claraInput').value=text;clara(true)};r.onend=()=>{};r.start()}
async function requestNotifications(){if(!('Notification'in window))return toast('Este navegador no permite notificaciones aquí.');if(Notification.permission==='default')await Notification.requestPermission();if(Notification.permission==='granted'){scheduleAllAlerts();toast('Avisos activados: 1 hora y 1 día antes.')}else toast('Los avisos necesitan permiso de notificaciones.')} 
function toast(t){let x=document.getElementById('toast');x.textContent=t;x.style.display='block';clearTimeout(window.tt);window.tt=setTimeout(()=>x.style.display='none',2600)}
function render(){let v=state.view;document.getElementById('app').innerHTML=v==='home'?home():v==='month'?month():v==='week'?week():v==='day'?day():v==='year'?year():settings()}
render();scheduleAllAlerts();
</script></body></html>
